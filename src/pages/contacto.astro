---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Contacto | Servicios de mantenimiento en Toluca | Mansir"
	description="Contacta a Mansir para solicitar servicios de mantenimiento integral, electricidad, plomería o remodelación en Toluca de Lerdo, Estado de México."
	keywords="contacto Mansir, solicitar mantenimiento Toluca, cotización de mantenimiento, servicios de mantenimiento Toluca, electricista en Toluca, plomero en Toluca, remodelación en Toluca, mantenimiento para casas, mantenimiento para negocios, construcción y reparaciones Estado de México"
>
	<main class="page-wrap py-10 sm:py-14 md:py-16">
		<header class="mx-auto mb-8 max-w-2xl text-center md:mx-0 md:text-left">
			<p class="text-sm font-semibold uppercase tracking-[0.16em] text-primary">Estamos para ayudarte</p>
			<h1 class="mt-3 font-display text-3xl font-bold text-stone-950 sm:text-4xl lg:text-5xl dark:text-stone-50">Contacto</h1>
			<p class="mt-4 text-base leading-7 text-stone-600 sm:text-lg dark:text-stone-300">
				Cuéntanos qué necesitas. Nuestro equipo te responderá para encontrar la solución adecuada para tí.
			</p>
		</header>

		<div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.8fr)] lg:gap-12">
			<form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="relative rounded-xl border border-stone-200 bg-white p-4 shadow-sm sm:p-7 dark:border-stone-800 dark:bg-stone-900">
				<input type="hidden" name="access_key" value={import.meta.env.VITE_WEB3FORMS_KEY} />
				<input type="hidden" name="subject" value="Nueva cotización" />
				<div class="grid gap-5">
					<div>
						<label for="name" class="mb-2 block text-center text-sm font-medium text-stone-800 md:text-left dark:text-stone-100">Nombre</label>
						<input id="name" name="name" type="text" placeholder="Nombre" autocomplete="name" required class="w-full rounded-lg border border-stone-300 bg-white px-4 py-3 text-base text-stone-900 outline-none transition placeholder:text-stone-400 focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-stone-700 dark:bg-stone-950 dark:text-stone-100 dark:placeholder:text-stone-500" />
					</div>
					<div>
						<label for="email" class="mb-2 block text-center text-sm font-medium text-stone-800 md:text-left dark:text-stone-100">Correo</label>
						<input id="email" name="email" type="email" placeholder="Correo" autocomplete="email" required class="w-full rounded-lg border border-stone-300 bg-white px-4 py-3 text-base text-stone-900 outline-none transition placeholder:text-stone-400 focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-stone-700 dark:bg-stone-950 dark:text-stone-100 dark:placeholder:text-stone-500" />
					</div>
					<div>
						<label for="message" class="mb-2 block text-center text-sm font-medium text-stone-800 md:text-left dark:text-stone-100">Mensaje</label>
						<textarea id="message" name="message" placeholder="Mensaje" rows="5" required class="w-full resize-y rounded-lg border border-stone-300 bg-white px-4 py-3 text-base text-stone-900 outline-none transition placeholder:text-stone-400 focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-stone-700 dark:bg-stone-950 dark:text-stone-100 dark:placeholder:text-stone-500"></textarea>
					</div>
					<button type="submit" class="mx-auto w-full rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-white transition hover:brightness-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:cursor-wait disabled:opacity-70 sm:w-fit md:mx-0 dark:text-stone-950">Enviar mensaje</button>
				</div>
				<section id="form-feedback" role="alertdialog" aria-modal="true" aria-labelledby="feedback-title" aria-describedby="feedback-message" tabindex="-1" hidden class="absolute inset-0 z-10 flex items-center justify-center rounded-xl bg-white/95 p-6 text-center backdrop-blur-sm dark:bg-stone-900/95">
					<div class="max-w-sm">
						<div id="feedback-icon" aria-hidden="true" class="mx-auto mb-4 flex size-14 items-center justify-center rounded-full bg-primary-soft text-2xl font-bold text-stone-900 dark:bg-stone-800 dark:text-stone-100"></div>
						<h2 id="feedback-title" class="font-display text-xl font-semibold text-stone-950 dark:text-stone-50"></h2>
						<p id="feedback-message" class="mt-2 text-sm leading-6 text-stone-600 dark:text-stone-300"></p>
						<button id="feedback-dismiss" type="button" class="mt-6 rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-white transition hover:brightness-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:text-stone-950">Volver al formulario</button>
					</div>
				</section>
			</form>

			<aside class="rounded-xl bg-primary-soft p-5 text-center sm:p-7 md:text-left dark:bg-stone-900">
				<h2 class="font-display text-xl font-semibold text-stone-950 dark:text-stone-50">Dónde nos encontramos</h2>
				<address class="mt-4 text-base leading-7 text-stone-700 not-italic dark:text-stone-300">
					Paloma Perdiz 62<br />
					Las Palomas, 50250<br />
					Toluca de Lerdo, Méx.
				</address>
				<div class="mt-7 border-t border-primary/20 pt-5 dark:border-stone-700">
					<h3 class="text-sm font-semibold uppercase tracking-wide text-stone-800 dark:text-stone-100">Horario de atención</h3>
					<dl class="mt-3 grid grid-cols-[1fr_auto] gap-x-4 gap-y-2 text-sm text-stone-700 dark:text-stone-300">
						<dt>Todos los días</dt><dd>24/7</dd>
					</dl>
				</div>
			</aside>
		</div>
	</main>
</Layout>

<script>
	const form = document.querySelector<HTMLFormElement>('#contact-form');
	const feedback = document.querySelector<HTMLElement>('#form-feedback');
	const feedbackIcon = document.querySelector<HTMLElement>('#feedback-icon');
	const feedbackTitle = document.querySelector<HTMLElement>('#feedback-title');
	const feedbackMessage = document.querySelector<HTMLElement>('#feedback-message');
	const dismissButton = document.querySelector<HTMLButtonElement>('#feedback-dismiss');
	const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!feedback || !feedbackIcon || !feedbackTitle || !feedbackMessage || !submitButton) return;

		submitButton.disabled = true;
		submitButton.textContent = 'Enviando...';

		let succeeded = false;
		try {
			const response = await fetch(form.action, {
				method: 'POST',
				body: new FormData(form),
				headers: { Accept: 'application/json' },
			});
			const result = await response.json();
			succeeded = response.ok && result.success === true;
		} catch {
			succeeded = false;
		}

		feedbackIcon.textContent = succeeded ? '\u2713' : '!';
		feedbackTitle.textContent = succeeded ? 'Gracias por contactarnos' : 'No pudimos enviar tu mensaje';
		feedbackMessage.textContent = succeeded
			? 'Recibimos tu mensaje. En breve te responderemos.'
			: 'Ocurrió un problema al enviar tu mensaje. Inténtalo de nuevo más tarde.';
		feedback.hidden = false;
		feedback.focus();
		submitButton.disabled = false;
		submitButton.textContent = 'Enviar mensaje';

		if (succeeded) form.reset();
	});

	dismissButton?.addEventListener('click', () => {
		if (!feedback || !submitButton) return;
		feedback.hidden = true;
		submitButton.focus();
	});
</script>